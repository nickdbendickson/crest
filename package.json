{
  "name": "crest",
  "version": "0.1.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17",
    "seroval": "^1.6.11",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint": {
      "minimatch": "^11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.1"
    },
    "@eslint/eslintrc": {
      "minimatch": "^11.0.1"
    }
  },
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 8080",
    "build": "vite build",
    "build:desktop": "node node_modules/vite/bin/vite.js build -c vite.desktop.config.ts",
    "data:nd-dams": "node scripts/build-nd-dams.mjs",
    "data:nd-dams-dwr": "node scripts/build-nd-dams-dwr.mjs",
    "data:nd-structures": "node scripts/build-nd-structures.mjs",
    "batch:dams": "node --experimental-strip-types scripts/batch-dams.mjs",
    "build:crest-html": "node node_modules/vite/bin/vite.js build -c vite.desktop.config.ts --mode singlefile",
    "test:desktop": "python3 crest-desktop/tests/test_smoke.py",
    "validate:crest": "node --experimental-strip-types scripts/validate-crest.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test 'src/lib/crest/*.test.ts'",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-table": "^8.21.0",
    "@tanstack/router-plugin": "^1.168.0",
    "@types/leaflet": "^1.9.20",
    "@vitejs/plugin-react": "^5.2.0",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "lightningcss": "^1.28.0",
    "lucide-react": "^1.70.0",
    "nitro": "3.0.260610-beta",
    "proj4": "^2.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^8.2.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/leaflet-draw": "^1.0.13",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.56.1"
  }
}
